<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.9.5.0</Version>
    <Description>In-game raid strategy planner with slide-based arena diagrams, per-player cooldown assignments and live shotcall reminders.</Description>
    <Authors>SorenWolfe</Authors>
    <PackageProjectUrl>https://github.com/sorenwolfe/Shikari</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Theme sprites ride inside the DLL, so there is no loose file to go missing on an install. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Emoji\*.png" LogicalName="Shikari.Resources.Emoji.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Emoji\index.txt" LogicalName="Shikari.Resources.Emoji.index.txt" />
    <EmbeddedResource Include="Resources\Emoji\LICENSE-GRAPHICS.txt" LogicalName="Shikari.Resources.Emoji.LICENSE-GRAPHICS.txt" />
    <EmbeddedResource Include="Resources\shadow.png" LogicalName="Shikari.Resources.shadow.png" />
    <EmbeddedResource Include="Resources\glow.png" LogicalName="Shikari.Resources.glow.png" />
    <EmbeddedResource Include="Resources\buddy-poses.png" LogicalName="Shikari.Resources.buddy-poses.png" />
  </ItemGroup>

</Project>
